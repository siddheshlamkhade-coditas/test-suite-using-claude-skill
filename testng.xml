<!--
  One class per API operation, listed in run order.
  parallel is OFF and preserve-order is ON, deliberately: a value extracted in one
  class is read by a later one through SharedValues, which is per-thread.
  The pet, order and user lifecycles each chain an id/username from a create response through to a delete via SharedValues, which is per-thread: parallel classes would put producer and consumer on different threads and the consumer would read null, intermittently. Not a request-spec problem; ApiClient returns a fresh spec per call.

  Ordering comes from @Test(priority) plus preserve-order. Where one step needs
  another to have passed, it declares dependsOnGroups, so a failed prerequisite
  SKIPS its dependents with a reason instead of failing them all.

  Run everything:  mvn test
  Smoke only:      mvn test -DsuiteXmlFile=smoke-testng.xml
-->
<suite name="Swagger Petstore API Tests Suite" parallel="false" verbose="1" configfailurepolicy="continue">

  <!-- Registered here and ONLY here. Adding @Listeners as well double-counts
       every test and produces two reports. -->
  <listeners>
    <listener class-name="com.petstore.api.report.ExtentListener"/>
  </listeners>

  <test name="All" thread-count="1" preserve-order="true">
    <classes>
      <!-- pet · priority 10-20 -->
      <class name="com.petstore.api.tests.pet.FindByStatusAvailableTest"/>
