      <class name="com.petstore.api.tests.pet.UpdatePetFullTest"/>
      <class name="com.petstore.api.tests.pet.UpdatePetFormTest"/>
      <class name="com.petstore.api.tests.pet.UploadPetImageTest"/>
      <class name="com.petstore.api.tests.pet.DeletePetTest"/>

      <!-- store · priority 110-130 -->
